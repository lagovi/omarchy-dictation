[Unit]
Description=NVIDIA Parakeet Speech-to-Text Background Engine
After=default.target

[Service]
Type=simple
ExecStart=/home/uzzzver/.local/share/gigaam-env/bin/python /home/uzzzver/.local/bin/gigaam-server.py
Restart=always
RestartSec=2

# Приоритет планировщика ядра Linux
Nice=-10

# Cgroups v2: максимальный вес CPU и I/O (1000 против стандартных 100)
CPUWeight=1000
StartupCPUWeight=1000
IOWeight=1000

# Быстрая выгрузка: если процесс завис, не ждать дольше 3 секунд
TimeoutStopSec=3s

# Защита от OOM-killer и свопинга
OOMScoreAdjust=-500
MemoryLow=800M

[Install]
WantedBy=default.target
